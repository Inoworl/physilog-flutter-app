default_platform(:ios)

platform :ios do
  ENV["FASTLANE_DISABLE_PTY"] = "1"
  ENV["FASTLANE_EXPLICIT_OPEN3"] = "1"
  ENV["FASTLANE_DISABLE_COLORS"] = "1"
  ENV["CI"] = "1"

  desc "Build and upload dev iOS to TestFlight"
  lane :dev do
    require "base64"
    require "fileutils"
    require "securerandom"

    profile_base64 = ENV["DEV_PROVISIONING_PROFILE_BASE64"].to_s
    profile_name = ENV["DEV_PROVISIONING_PROFILE_SPECIFIER"].to_s
    team_id = ENV["DEVELOPMENT_TEAM_ID"].to_s
    asc_key_id = ENV["ASC_KEY_ID"].to_s
    asc_issuer_id = ENV["ASC_ISSUER_ID"].to_s
    asc_api_key_base64 = ENV["ASC_API_KEY_BASE64"].to_s

    if profile_base64.empty? || profile_name.empty?
      UI.user_error!("DEV_PROVISIONING_PROFILE_BASE64 and DEV_PROVISIONING_PROFILE_SPECIFIER are required")
    end
    if team_id.empty?
      UI.user_error!("DEVELOPMENT_TEAM_ID is required")
    end
    if asc_key_id.empty? || asc_issuer_id.empty? || asc_api_key_base64.empty?
      UI.user_error!("ASC_KEY_ID, ASC_ISSUER_ID and ASC_API_KEY_BASE64 are required")
    end

    build_number = (20000 + sh("cd .. && git rev-list --all --count", log: false).strip.to_i).to_s
    UI.message("Build number: #{build_number}")

    api_key_path = "./AuthKey.p8"
    profile_dir = File.join(ENV["HOME"], "Library/MobileDevice/Provisioning Profiles")
    profile_path = File.join(profile_dir, "#{SecureRandom.uuid}.mobileprovision")

    begin
      FileUtils.mkdir_p(profile_dir)
      File.binwrite(profile_path, Base64.decode64(profile_base64))

      sh "cd .. && flutter pub get"
      sh "pod install"

      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "dev",
        configuration: "Release-dev",
        export_method: "app-store",
        output_directory: "./build",
        output_name: "PhysiLog-Dev.ipa",
        silent: false,
        suppress_xcode_output: false,
        buildlog_path: "./build/logs",
        clean: true,
        xcargs: "DEVELOPMENT_TEAM=#{team_id}",
        export_options: {
          method: "app-store",
          teamID: team_id,
          signingStyle: "manual",
          provisioningProfiles: {
            "com.physilog.physiLog.dev" => profile_name
          },
          uploadBitcode: false,
          compileBitcode: false,
          uploadSymbols: true
        }
      )

      File.binwrite(api_key_path, Base64.decode64(asc_api_key_base64))
      api_key = app_store_connect_api_key(
        key_id: asc_key_id,
        issuer_id: asc_issuer_id,
        key_filepath: File.expand_path(api_key_path),
        in_house: false
      )

      upload_to_testflight(
        api_key: api_key,
        ipa: "./build/PhysiLog-Dev.ipa",
        skip_waiting_for_build_processing: true,
        skip_submission: true
      )
    ensure
      [api_key_path, profile_path].each do |path|
        begin
          FileUtils.rm_f(path)
        rescue
        end
      end
    end
  end
end
